{
    "name": "matthieuthuetdev/simple-ai",
    "description": "A simple PHP library to interact with OpenAI models.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "autoload": {
        "psr-4": {
            "SimpleAI\\": "src/"
        }
    },
    "scripts": {
        "style": "php-cs-fixer fix --dry-run --diff --using-cache=no"
    },
    "config": {
        "sort-packages": true
    }
}
